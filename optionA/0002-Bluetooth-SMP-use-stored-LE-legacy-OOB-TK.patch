From: Russell Oliver <roliver8143@gmail.com>
Date: Fri, 11 Sep 2026 02:00:00 +0000
Subject: [PATCH 2/5] Bluetooth: SMP: use a stored LE legacy OOB Temporary Key

When a stored LE legacy OOB Temporary Key (TK) exists for a peer, use it
in the in-kernel Security Manager Protocol (SMP) so pairing can complete
without userspace needing to seize the controller (HCI_CHANNEL_USER).

Conditions: link is LE, SMP Secure Connections is not active, and the
stored oob entry has le_legacy_tk_present. In that case copy the 16-byte
TK into smp->tk, mark SMP_FLAG_TK_VALID and SMP_FLAG_MITM_AUTH, raise the
pending security level to BT_SECURITY_HIGH, and mark the SMP context as
`oob_present` so build_pairing_cmd() advertises SMP_OOB_PRESENT.

Zero the stored TK and remove ephemeral entries on successful pairing; the
local smp->tk copy is zeroed on completion to avoid lingering secret data.

Signed-off-by: Russell Oliver <roliver8143@gmail.com>
---
*** Begin Patch
*** Update File: net/bluetooth/smp.c
@@
 #include "hci_core.h"
 #include "smp.h"
+#include "oob.h" /* hypothetical header for oob helpers */
@@
 static void tk_request(struct smp *smp)
 {
     struct hci_conn *hcon = smp->hcon;
+    struct oob_data *oob = NULL;
 
     /* existing validation and fallback logic */
-
-    /* existing logic to set smp->tk = 0 or passkey */
+
+    /* Try stored LE legacy OOB TK first (Option A behavior) */
+    if (!(smp->flags & SMP_FLAG_SC) && hcon && hcon->type == LE_LINK) {
+        oob = hci_remote_oob_data_lookup(hcon->hdev, &hcon->dst);
+        if (oob && oob->le_legacy_tk_present) {
+            memcpy(smp->tk, oob->le_legacy_tk, sizeof(oob->le_legacy_tk));
+            smp->flags |= SMP_FLAG_TK_VALID | SMP_FLAG_MITM_AUTH;
+            smp->pending_sec_level = BT_SECURITY_HIGH;
+            smp->oob_present = 1; /* used by build_pairing_cmd() */
+            /* TK is secret: do NOT log or emit its bytes */
+            return;
+        }
+    }
+
+    /* existing fallback logic continues here: Just Works / passkey */
 }
@@
 static void pairing_complete(struct smp *smp)
 {
     /* existing completion handling */
+    /* If we used a stored ephemeral OOB TK, remove it on success and zero */
+    if (smp->hcon && smp->oob_present) {
+        struct oob_data *oob = hci_remote_oob_data_lookup(smp->hcon->hdev,
+                                                         &smp->hcon->dst);
+        if (oob && oob->le_legacy_tk_present && !oob_is_persistent(oob)) {
+            memzero_explicit(oob->le_legacy_tk, sizeof(oob->le_legacy_tk));
+            oob->le_legacy_tk_present = 0;
+            hci_remove_remote_oob_data(oob);
+        }
+    }
+
+    /* Zero local copy of TK in smp context to avoid later leakage */
+    memzero_explicit(smp->tk, sizeof(smp->tk));
 }
*** End Patch
*** End Update
