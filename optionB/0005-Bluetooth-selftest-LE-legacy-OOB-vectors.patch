From fb6b36570e9121457defd0b11128bad1677ebbf5 Mon Sep 17 00:00:00 2001
From: Russell Oliver <roliver8143@gmail.com>
Date: Fri, 11 Sep 2026 12:33:43 +1000
Subject: [PATCH 5/5] Bluetooth: selftest: add LE legacy OOB SMP vectors

test_c1() and test_s1() only cover the all-zero Temporary Key of the Core
specification sample data, which is what Just Works uses.  LE legacy OOB
pairing feeds a 128-bit key from an out of band channel into the same two
functions, so add vectors that use one.

The c1 case is run twice, the second time with one bit of the key flipped,
to check that a peer that used a different Temporary Key cannot produce a
confirm value we would accept.

No capture of a real LE legacy OOB pairing was available to take these
from, so they are computed rather than observed, and the commentary above
them says so.  Everything but the key and preq/pres is the Core
specification c1/s1 sample input; preq/pres are a request/response pair of
the shape such a pairing produces.  The expected outputs were generated
with an independent AES-128 implementation, validated by having it
reproduce the results that test_c1() and test_s1() already check.

Signed-off-by: Russell Oliver <roliver8143@gmail.com>
---
 net/bluetooth/smp.c | 98 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 98 insertions(+)

diff --git a/net/bluetooth/smp.c b/net/bluetooth/smp.c
index 4a6f6a879..ab29e9afe 100644
--- a/net/bluetooth/smp.c
+++ b/net/bluetooth/smp.c
@@ -3625,6 +3625,92 @@ static int __init test_s1(void)
 	return 0;
 }
 
+/* LE legacy OOB pairing: the Temporary Key is the 128-bit key exchanged out
+ * of band rather than a passkey or zero, so exercise c1/s1 with a key whose
+ * every octet differs from zero.  test_c1()/test_s1() above only cover the
+ * all-zero key of the Core specification sample data.
+ *
+ * Provenance: no capture of a real LE legacy OOB pairing was available to
+ * take these from, so they are computed rather than observed.  The inputs
+ * other than the key are the Core specification c1/s1 sample inputs, with
+ * preq/pres replaced by a request/response pair of the shape such a pairing
+ * produces: NoInputNoOutput IO capabilities on both sides, OOB flag present,
+ * no Secure Connections bit in AuthReq.  The expected outputs were generated
+ * with an independent AES-128 implementation, validated by having it
+ * reproduce the sample data results checked by test_c1() and test_s1().
+ */
+static int __init test_c1_le_legacy_oob(void)
+{
+	/* TK 000102030405060708090a0b0c0d0e0f */
+	const u8 k[16] = {
+			0x0f, 0x0e, 0x0d, 0x0c, 0x0b, 0x0a, 0x09, 0x08,
+			0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0x00 };
+	/* The same key with a single bit flipped */
+	const u8 k_bad[16] = {
+			0x0e, 0x0e, 0x0d, 0x0c, 0x0b, 0x0a, 0x09, 0x08,
+			0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0x00 };
+	const u8 r[16] = {
+			0xe0, 0x2e, 0x70, 0xc6, 0x4e, 0x27, 0x88, 0x63,
+			0x0e, 0x6f, 0xad, 0x56, 0x21, 0xd5, 0x83, 0x57 };
+	/* NoInputNoOutput, OOB present, Bonding | CT2 */
+	const u8 preq[7] = { 0x01, 0x03, 0x01, 0x21, 0x10, 0x07, 0x07 };
+	const u8 pres[7] = { 0x02, 0x03, 0x01, 0x0d, 0x10, 0x07, 0x07 };
+	const u8 _iat = 0x01;
+	const u8 _rat = 0x00;
+	const bdaddr_t ra = { { 0xb6, 0xb5, 0xb4, 0xb3, 0xb2, 0xb1 } };
+	const bdaddr_t ia = { { 0xa6, 0xa5, 0xa4, 0xa3, 0xa2, 0xa1 } };
+	const u8 exp[16] = {
+			0x3f, 0xaf, 0x18, 0xde, 0xe8, 0xa5, 0x34, 0x0f,
+			0x6e, 0xc9, 0x23, 0x89, 0x85, 0x0b, 0x4f, 0x09 };
+	u8 res[16];
+	int err;
+
+	err = smp_c1(k, r, preq, pres, _iat, &ia, _rat, &ra, res);
+	if (err)
+		return err;
+
+	if (crypto_memneq(res, exp, 16))
+		return -EINVAL;
+
+	/* A peer that used a different Temporary Key must not produce a
+	 * confirm value we would accept.
+	 */
+	err = smp_c1(k_bad, r, preq, pres, _iat, &ia, _rat, &ra, res);
+	if (err)
+		return err;
+
+	if (!crypto_memneq(res, exp, 16))
+		return -EINVAL;
+
+	return 0;
+}
+
+static int __init test_s1_le_legacy_oob(void)
+{
+	/* TK 000102030405060708090a0b0c0d0e0f */
+	const u8 k[16] = {
+			0x0f, 0x0e, 0x0d, 0x0c, 0x0b, 0x0a, 0x09, 0x08,
+			0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0x00 };
+	const u8 r1[16] = {
+			0x88, 0x77, 0x66, 0x55, 0x44, 0x33, 0x22, 0x11 };
+	const u8 r2[16] = {
+			0x00, 0xff, 0xee, 0xdd, 0xcc, 0xbb, 0xaa, 0x99 };
+	const u8 exp[16] = {
+			0x50, 0x5e, 0xd3, 0x94, 0x4e, 0x33, 0xde, 0x95,
+			0xe6, 0x0a, 0x84, 0xa7, 0x87, 0xdd, 0xbe, 0x0d };
+	u8 res[16];
+	int err;
+
+	err = smp_s1(k, r1, r2, res);
+	if (err)
+		return err;
+
+	if (crypto_memneq(res, exp, 16))
+		return -EINVAL;
+
+	return 0;
+}
+
 static int __init test_f4(void)
 {
 	const u8 u[32] = {
@@ -3828,6 +3914,18 @@ static int __init run_selftests(struct crypto_kpp *tfm_ecdh)
 		goto done;
 	}
 
+	err = test_c1_le_legacy_oob();
+	if (err) {
+		BT_ERR("smp_c1 LE legacy OOB test failed");
+		goto done;
+	}
+
+	err = test_s1_le_legacy_oob();
+	if (err) {
+		BT_ERR("smp_s1 LE legacy OOB test failed");
+		goto done;
+	}
+
 	err = test_f4();
 	if (err) {
 		BT_ERR("smp_f4 test failed");
